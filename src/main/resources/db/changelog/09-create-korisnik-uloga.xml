<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="09-01-create-uloga" author="andjela">
        <createTable tableName="uloga">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="naziv" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
        <insert tableName="uloga">
            <column name="naziv" value="ADMIN"/>
        </insert>
        <insert tableName="uloga">
            <column name="naziv" value="STUDENT"/>
        </insert>
        <rollback>
            <dropTable tableName="uloga"/>
        </rollback>
    </changeSet>

    <changeSet id="09-02-create-korisnik" author="andjela">
        <createTable tableName="korisnik">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="uloga_id" type="BIGINT">
                <constraints nullable="false"
                    foreignKeyName="fk_korisnik_uloga"
                    references="uloga(id)"/>
            </column>
        </createTable>
        <insert tableName="korisnik">
            <column name="username" value="admin"/>
            <column name="password" value="$2a$10$N.zmdr9k7uOCQb376NoUnuTJ8iAt6Z5EHsM8lE9lBpwTTyBNR1gni"/>
            <column name="uloga_id" value="1"/>
        </insert>
        <insert tableName="korisnik">
            <column name="username" value="student"/>
            <column name="password" value="$2a$10$8K1p/a0dhrxSA8ozquVT.uR.uFGGBGJdTGgBqFOIiTQkMYQFHjuWu"/>
            <column name="uloga_id" value="2"/>
        </insert>
        <rollback>
            <dropTable tableName="korisnik"/>
        </rollback>
    </changeSet>

</databaseChangeLog>